	LoginBanner string            `xml:"login_banner,omitempty"    json:"loginBanner,omitempty"   yaml:"loginBanner,omitempty"`
	SavePasswd  opnsense.BoolFlag `xml:"save_passwd,omitempty"     json:"savePasswd"              yaml:"savePasswd,omitempty"`
