func (p IPsecPhase2) MarshalXML(e *xml.Encoder, start xml.StartElement) error
    MarshalXML implements custom XML marshaling for IPsecPhase2, ensuring
    that the Disabled BoolFlag field is addressable so (*BoolFlag).MarshalXML
